rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────────

    // Comprueba si el usuario autenticado tiene un documento en /admins/{uid}
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Valida que un número es positivo y finito
    function isPositiveNumber(val) {
      return val is number && val > 0 && val < 1000000;
    }

    // Valida longitud máxima de string
    function maxLen(val, n) {
      return val is string && val.size() <= n;
    }

    // ─── Productos ────────────────────────────────────────────────────────────
    // Lectura pública; solo admins pueden escribir; validación de esquema.
    match /productos/{productId} {
      allow read: if true;

      allow create: if isAdmin()
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() >= 2
        && request.resource.data.titulo.size() <= 300
        && isPositiveNumber(request.resource.data.precio)
        && request.resource.data.categoria is string
        && maxLen(request.resource.data.categoria, 100)
        && (!(request.resource.data.keys().hasAny(['stock']))
            || (request.resource.data.stock is int
                && request.resource.data.stock >= 0
                && request.resource.data.stock <= 9999));

      allow update: if isAdmin()
        && (!(request.resource.data.keys().hasAny(['titulo']))
            || (request.resource.data.titulo is string
                && request.resource.data.titulo.size() >= 2
                && request.resource.data.titulo.size() <= 300))
        && (!(request.resource.data.keys().hasAny(['precio']))
            || isPositiveNumber(request.resource.data.precio))
        && (!(request.resource.data.keys().hasAny(['stock']))
            || (request.resource.data.stock is int
                && request.resource.data.stock >= 0
                && request.resource.data.stock <= 9999));

      allow delete: if isAdmin();
    }

    // ─── Admins ───────────────────────────────────────────────────────────────
    // Solo otros admins pueden leer la lista; NADIE puede escribir desde el cliente.
    // La creación de admins se hace ÚNICAMENTE desde Firebase Console o Cloud Functions.
    match /admins/{userId} {
      allow read: if isAdmin();
      allow write: if false; // Solo Firebase Console / Cloud Functions
    }

    // ─── Pedidos (orders) ─────────────────────────────────────────────────────
    // Cualquier visitante puede CREAR (una vez por flujo de WhatsApp).
    // Solo admins pueden leer, editar o borrar.
    match /orders/{orderId} {
      allow create: if request.resource.data.orderCode is string
        && request.resource.data.orderCode.size() <= 30
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.total < 1000000
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 2
        && request.resource.data.customerName.size() <= 150
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() >= 7
        && request.resource.data.customerPhone.size() <= 20;

      allow read, update, delete: if isAdmin();
    }

    // ─── Reclamaciones ────────────────────────────────────────────────────────
    // Creación pública (formulario legal); lectura/borrado solo admins.
    match /reclamaciones/{claimId} {
      allow create: if request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 2
        && request.resource.data.fullName.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.docNumber is string
        && request.resource.data.docNumber.size() <= 20
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 2000
        && request.resource.data.request is string
        && request.resource.data.request.size() <= 1000;

      allow read, update, delete: if isAdmin();
    }

    // ─── Reseñas de productos (colección raíz 'reviews') ─────────────────────
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.productId is string
        && request.resource.data.productId.size() <= 100
        && request.resource.data.userName is string
        && request.resource.data.userName.size() >= 2
        && request.resource.data.userName.size() <= 100
        && request.resource.data.comment is string
        && request.resource.data.comment.size() >= 2
        && request.resource.data.comment.size() <= 2000
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;
      allow update, delete: if isAdmin();
    }

    // Compatibilidad con subcolección /productos/{productId}/reviews
    match /productos/{productId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000;
      allow update, delete: if isAdmin();
    }

    // ─── Perfiles de usuario ──────────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if isAdmin();
    }

    // ─── DENY-ALL por defecto ─────────────────────────────────────────────────
    // Cualquier colección no declarada arriba queda completamente bloqueada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
